{
  "id": "noctalia-model-usage",
  "name": "Model Usage",
  "version": "0.2.3",
  "minNoctaliaVersion": "4.4.1",
  "author": "cmptr",
  "license": "MIT",
  "description": "Shows AI coding assistant usage stats in the bar with detail panel (Claude Code, Codex, Copilot, OpenRouter, Zen, DeepSeek)",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "tags": [
    "Bar",
    "Productivity",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "providers": {
        "claude": {
          "enabled": false,
          "showInWidget": true,
          "statsPath": "~/.claude/stats-cache.json",
          "credentialsPath": "~/.claude/.credentials.json"
        },
        "codex": {
          "enabled": false,
          "showInWidget": true,
          "usageMode": "local"
        },
        "copilot": {
          "enabled": false,
          "showInWidget": true
        },
        "openrouter": {
          "enabled": false,
          "showInWidget": true,
          "apiKey": ""
        },
        "zen": {
          "enabled": false,
          "showInWidget": true,
          "apiKey": ""
        },
        "deepseek": {
          "enabled": false,
          "showInWidget": true,
          "apiKey": ""
        }
      },
      "barCycleEnabled": false,
      "barCycleIntervalSec": 5,
      "barMetric": "prompts",
      "includeCacheTokens": true,
      "barShowRemaining": false,
      "barTextShowOnHover": false,
      "barIconAlertOnLimit": false,
      "barIconAlertThreshold": 95,
      "refreshIntervalSec": 30,
      "apiRefreshIntervalMin": 1,
      "providerOrder": [
        "claude",
        "codex",
        "copilot",
        "openrouter",
        "zen",
        "deepseek"
      ]
    }
  }
}
