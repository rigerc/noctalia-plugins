{
  "id": "mpm-tray",
  "name": "MPM Tray",
  "version": "1.0.0",
  "minNoctaliaVersion": "4.4.1",
  "author": "rigerc",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Shows available package updates from meta-package-manager (mpm) in the bar.",
  "tags": ["Bar", "Panel", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "refreshIntervalMinutes": 30,
      "disabledManagers": [],
      "hideOnZero": false,
      "presyncCmd": "(checkupdates; paru -Qua) 2>/dev/null; exit 0",
      "refreshOnStartup": true
    }
  }
}
